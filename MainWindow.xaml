<Window x:Class="GlassBubbleOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass Bubble Overlay"
        Width="250" Height="250"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#01FFFFFF"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="True"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        KeyDown="Window_KeyDown">
    <Grid>
        <Path x:Name="GlassShape" Stretch="Fill"
              Data="M 40,8 C 18,8 8,18 8,40 L 8,170 C 8,192 18,202 40,202 L 166,202 C 184,202 196,193 200,177 C 202,168 201,158 207,151 C 214,143 226,140 239,135 C 221,132 207,127 201,115 L 201,40 C 201,18 191,8 169,8 Z"
              Fill="#32DDF2FF" Stroke="#A8EAFBFF" StrokeThickness="1.4">
            <Path.Effect>
                <DropShadowEffect Color="#18314F" BlurRadius="22" ShadowDepth="5" Opacity="0.42"/>
            </Path.Effect>
        </Path>
        <Path Margin="9" Stretch="Fill"
              Data="M 40,8 C 18,8 8,18 8,40 L 8,170 C 8,192 18,202 40,202 L 166,202 C 184,202 196,193 200,177 C 202,168 201,158 207,151 C 214,143 226,140 239,135"
              Stroke="#D9FFFFFF" StrokeThickness="2.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Opacity="0.95" IsHitTestVisible="False"/>
        <Path Margin="11" Stretch="Fill"
              Data="M 40,8 C 18,8 8,18 8,40 L 8,170"
              Stroke="#FFFFFFFF" StrokeThickness="3.2"
              StrokeStartLineCap="Round" Opacity="0.72"
              IsHitTestVisible="False"/>
        <Path Margin="10" Stretch="Fill"
              Data="M 169,8 C 191,8 201,18 201,40 L 201,115"
              Stroke="#7BD7FFFF" StrokeThickness="1.5"
              StrokeStartLineCap="Round" Opacity="0.62"
              IsHitTestVisible="False"/>
        <Path Margin="7" Stretch="Fill"
              Data="M 40,8 C 18,8 8,18 8,40 L 8,170"
              Stroke="#75BFFFFF" StrokeThickness="1"
              StrokeStartLineCap="Round" Opacity="0.85"
              IsHitTestVisible="False"/>
        <Path Margin="12" Stretch="Fill"
              Data="M 169,8 C 191,8 201,18 201,40 L 201,115"
              Stroke="#A58DFFFF" StrokeThickness="1"
              StrokeStartLineCap="Round" Opacity="0.55"
              IsHitTestVisible="False"/>
        <Border Margin="26,25,26,45" Background="#12FFFFFF" CornerRadius="24"
                BorderBrush="#35FFFFFF" BorderThickness="1"
                IsHitTestVisible="False"/>
        <TextBlock x:Name="InfoText"
                   Text="GLASS OVERLAY&#10;Informations dynamiques"
                   Foreground="#F7FFFFFF"
                   FontFamily="Segoe UI Variable Display"
                   FontSize="15" FontWeight="SemiBold"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="30,20,30,48">
            <TextBlock.Effect>
                <DropShadowEffect Color="#40506A" BlurRadius="8" ShadowDepth="1" Opacity="0.6"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
